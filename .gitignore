# Python / сборка (локальное тестирование — в git не уходит)
__pycache__/
*.egg-info/
*.pyc
build/
dist/
*.whl
*.egg

# Локальные настройки инструментов и артефакты
.claude/
.vscode/
.idea/
demo_seed.py
gen_deploy.py
deploy_paste.sh
tests_paste.sh
